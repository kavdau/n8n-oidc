# Copy to .env and adjust. The client secret goes into ./secrets/oidc_client_secret.
N8N_HOST=n8n.example.com
GENERIC_TIMEZONE=Europe/Berlin

OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=paste-the-client-id-from-pocket-id
OIDC_OWNER_EMAIL=you@example.com
OIDC_ALLOWED_GROUPS=n8n-users
OIDC_BUTTON_LABEL=Sign in with Pocket ID
